#!/bin/sh
# /etc is read-only: an empty machine-id makes systemd use a transient one (in a VM derived from the firmware UUID)
# instead of trying to write one on the first boot.
set -e
: > "$BUILDROOT/etc/machine-id"
# The time zone is chosen in OpenHU (openhu-time) and lives on the data partition; tmpfiles creates the default
ln -sfn ../var/lib/openhu-os/time/localtime "$BUILDROOT/etc/localtime"
rm -f "$BUILDROOT/etc/timezone"
