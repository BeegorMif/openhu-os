#!/bin/sh
# The openhu package's own unit runs as root with eglfs (openhu#8); openhu-session.service replaces it.
set -e
# users and their directories from mkosi.extra (sysusers.d, tmpfiles.d); systemd does not apply them at boot
systemd-sysusers
systemd-tmpfiles --create --prefix=/var/lib/openhu
systemctl mask openhu.service
systemctl set-default graphical.target
# Writes a random seed to the ESP on every boot: not needed by a head unit, and a write on every boot
systemctl mask systemd-boot-random-seed.service
# The splash stays until openhu-session takes the display over (plymouth quit --retain-splash); Plymouth's own quit
# at the end of the boot would leave a black screen in between
systemctl mask plymouth-quit.service plymouth-quit-wait.service
# /etc is read-only: NetworkManager writes resolv.conf to /run
ln -sf ../run/NetworkManager/resolv.conf /etc/resolv.conf
# Every device creates its own ssh host keys on the data partition (/usr/libexec/openhu-os/ssh-hostkeys), not the
# ones the package generated while the image was built
rm -f /etc/ssh/ssh_host_*
# ssh: root's password from the data partition (openhu-ssh password), before the image's own accounts
sed -i 's|^@include common-auth|auth sufficient pam_pwdfile.so pwdfile=/var/lib/openhu-os/ssh/passwd\n@include common-auth|' /etc/pam.d/sshd
grep -q pam_pwdfile /etc/pam.d/sshd
