#!/usr/bin/python3
"""Calls a method of the OpenHU WebSocket API: openhu-api METHOD [JSON params], e.g. openhu-api system.ping"""
import json
import sys

from websockets.sync.client import connect

if len(sys.argv) < 2:
    sys.exit(__doc__)
params = json.loads(sys.argv[2]) if len(sys.argv) > 2 else {}
with connect("ws://127.0.0.1:5520", open_timeout=5) as ws:
    ws.send(json.dumps({"type": "request", "id": 1, "method": sys.argv[1], "params": params}))
    while True:
        reply = json.loads(ws.recv(timeout=10))
        if reply.get("id") == 1:
            break
print(json.dumps(reply.get("result", reply.get("error")), ensure_ascii=False))
sys.exit(1 if "error" in reply else 0)
