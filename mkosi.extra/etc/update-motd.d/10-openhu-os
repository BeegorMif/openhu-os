#!/bin/sh
# Login greeting (ssh, console), replaces Debian's uname line and /etc/motd: version, the last update, the most
# useful commands. pam_motd runs it at every login.
. /usr/lib/os-release
printf '\n  %s\n\n' "$PRETTY_NAME"
if [ -r /run/openhu-os/boot-status.json ]; then
  python3 - /run/openhu-os/boot-status.json <<'PY'
import json, sys
s = json.load(open(sys.argv[1]))
message = {
    "updated": f"Update to {s.get('running')} installed.",
    "trial": f"Checking the new version {s.get('running')} (try {s.get('attempt')} of {s.get('tries')}).",
    "rollback": f"Update to {s.get('failed')} failed, the previous version runs again.",
}.get(s.get("state"))
if message:
    print(f"  {message}\n")
PY
fi
cat <<'TEXT'
  /      read-only (erofs), only updated as a whole
  /var   data: OpenHU in /var/lib/openhu, the journal only in RAM

  openhu-cli help                     all commands (Tab completes)
  openhu-cli status                   versions, OpenHU, Android Auto, WiFi
  openhu-cli update check | install   system update
  openhu-cli config list | set        settings of OpenHU
  openhu-cli log | restart            log of OpenHU, restart it (start, stop)

TEXT
