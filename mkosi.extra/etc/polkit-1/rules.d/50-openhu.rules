// The openhu user controls NetworkManager (wireless Android Auto hotspot), may reboot/power off and run the
// OpenHU OS helpers as root with pkexec (ssh switch and password, system update, time zone and time).
polkit.addRule(function(action, subject) {
    if (subject.user != "openhu")
        return polkit.Result.NOT_HANDLED;
    if (action.id.indexOf("org.freedesktop.NetworkManager.") == 0)
        return polkit.Result.YES;
    if (action.id == "org.freedesktop.login1.reboot" || action.id == "org.freedesktop.login1.power-off"
        || action.id == "org.freedesktop.login1.reboot-multiple-sessions"
        || action.id == "org.freedesktop.login1.power-off-multiple-sessions")
        return polkit.Result.YES;
    if (action.id == "org.freedesktop.policykit.exec"
        && (action.lookup("program") == "/usr/libexec/openhu-os/openhu-ssh"
            || action.lookup("program") == "/usr/libexec/openhu-os/openhu-update"
            || action.lookup("program") == "/usr/libexec/openhu-os/openhu-time"))
        return polkit.Result.YES;
    return polkit.Result.NOT_HANDLED;
});
