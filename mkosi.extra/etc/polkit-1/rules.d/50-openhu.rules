// The openhu user controls NetworkManager (wireless Android Auto hotspot), may reboot/power off and run the system
// commands of openhu-cli as root with pkexec (system update, ssh switch and password, time zone and time,
// restart of OpenHU): OpenHU's settings use them, and openhu-cli runs itself so for the openhu user.
polkit.addRule(function(action, subject) {
    if (subject.user != "openhu")
        return polkit.Result.NOT_HANDLED;
    if (action.id.indexOf("org.freedesktop.NetworkManager.") == 0)
        return polkit.Result.YES;
    if (action.id == "org.freedesktop.login1.reboot" || action.id == "org.freedesktop.login1.power-off"
        || action.id == "org.freedesktop.login1.reboot-multiple-sessions"
        || action.id == "org.freedesktop.login1.power-off-multiple-sessions")
        return polkit.Result.YES;
    if (action.id == "org.freedesktop.policykit.exec" && action.lookup("program") == "/usr/bin/openhu-cli"
        && /^\/usr\/bin\/openhu-cli (update|ssh|time|restart)( |$)/.test(action.lookup("command_line")))
        return polkit.Result.YES;
    return polkit.Result.NOT_HANDLED;
});
